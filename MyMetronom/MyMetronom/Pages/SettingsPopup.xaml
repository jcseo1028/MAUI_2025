<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
       x:Class="MyMetronom.Pages.SettingsPopup">
    <Border StrokeThickness="0" BackgroundColor="#80000000">
        <Grid Padding="24" HorizontalOptions="Center" VerticalOptions="Center">
            <Frame CornerRadius="12" HasShadow="True" Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <VerticalStackLayout Spacing="12" WidthRequest="320">
                    <Label Text="Settings" Style="{StaticResource SubHeadline}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="Flash on Tick" VerticalOptions="Center" />
                        <Switch x:Name="FlashSwitch" Grid.Column="1" Toggled="OnFlashToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="Accent Volume" VerticalOptions="Center" />
                        <Slider x:Name="AccentVolume" Grid.Column="1" Minimum="0" Maximum="1" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>
		<!--
		<Button Text="Close" Clicked="OnCloseClicked" />
		-->
    </Border>
</toolkit:Popup>
