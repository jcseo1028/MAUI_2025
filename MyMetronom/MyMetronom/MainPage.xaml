<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMetronom.MainPage"
             Title="Metronome">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings" Priority="0" Order="Primary" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16,16,16,0">
            <Frame CornerRadius="12" HasShadow="False" Padding="0" BackgroundColor="Transparent">
                <Grid Padding="0">
                    <BoxView x:Name="TickIndicator"
                             BackgroundColor="{StaticResource Primary}"
                             Opacity="0.29"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill"
                             InputTransparent="True" />

                    <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Start">
                        <Label Text="Metronome" Style="{StaticResource Headline}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Text="BPM" VerticalOptions="Center" />
                            <Slider x:Name="BpmSlider"
                                    Grid.Column="1"
                                    Minimum="30" Maximum="300"
                                    ValueChanged="OnBpmChanged" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Button Text="-" Clicked="OnBpmDownClicked" />
                            <Label x:Name="BpmLabel" Grid.Column="1" Text="120 BPM" VerticalOptions="Center" HorizontalOptions="Center" />
                            <Button Grid.Column="2" Text="+" Clicked="OnBpmUpClicked" />
                            <Button Grid.Column="3"
                                    x:Name="StartStopButton"
                                    Text="Start"
                                    Clicked="OnStartStopClicked" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Text="" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <RadioButton x:Name="QuarterRadio" GroupName="Subdivision" Style="{StaticResource FlatRadioButton}" CheckedChanged="OnSubdivisionRadioCheckedChanged">
                                    <RadioButton.Content>
                                        <HorizontalStackLayout Spacing="1">
                                            <Image Source="dot_4.png" HeightRequest="32" WidthRequest="32"/>
                                            <Label Text=""/>
                                        </HorizontalStackLayout>
                                    </RadioButton.Content>
                                </RadioButton>
                                <RadioButton x:Name="EighthRadio" GroupName="Subdivision" Style="{StaticResource FlatRadioButton}" CheckedChanged="OnSubdivisionRadioCheckedChanged">
                                    <RadioButton.Content>
                                        <HorizontalStackLayout Spacing="1">
                                            <Image Source="dot_8.png" HeightRequest="32" WidthRequest="32"/>
                                            <Label Text=""/>
                                        </HorizontalStackLayout>
                                    </RadioButton.Content>
                                </RadioButton>
                                <RadioButton x:Name="TripletRadio" GroupName="Subdivision" Style="{StaticResource FlatRadioButton}" CheckedChanged="OnSubdivisionRadioCheckedChanged">
                                    <RadioButton.Content>
                                        <HorizontalStackLayout Spacing="1">
                                            <Image Source="dot_8_3.png" HeightRequest="32" WidthRequest="32"/>
                                            <Label Text=""/>
                                        </HorizontalStackLayout>
                                    </RadioButton.Content>
                                </RadioButton>
                                <RadioButton x:Name="SixteenthRadio" GroupName="Subdivision" Style="{StaticResource FlatRadioButton}" CheckedChanged="OnSubdivisionRadioCheckedChanged">
                                    <RadioButton.Content>
                                        <HorizontalStackLayout Spacing="1">
                                            <Image Source="dot_16.png" HeightRequest="32" WidthRequest="32"/>
                                            <Label Text=""/>
                                        </HorizontalStackLayout>
                                    </RadioButton.Content>
                                </RadioButton>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <VerticalStackLayout Padding="0,8,0,16" Spacing="8">
                <Label Text="YouTube" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="YoutubeUrlEntry" Placeholder="YouTube URL 또는 동영상 ID 입력" TextChanged="OnYoutubeTextChanged" />
                    <Button Grid.Column="1" Text="Load" Clicked="OnLoadYoutubeClicked" />
                </Grid>
                <WebView x:Name="YoutubeWebView" HeightRequest="360" IsVisible="False" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
